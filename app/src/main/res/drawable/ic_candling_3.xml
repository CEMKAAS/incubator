<!--
  Третье овоскопирование: последняя проверка перед выводом.

  Яйцо тёмное почти целиком, просвечивает только воздушная камера — большая и с
  неровной границей, потому что зародыш подтягивает её на себя. Это и описывает
  stageGoal(3) в CandlingSheet.kt, и «неровная граница» здесь нарисована буквально:
  пол камеры идёт волной, а не прямой.

  Боковины камеры — та же кривая скорлупы, разрезанная по де Кастельжо ещё ниже, чем
  на втором овоскопировании (t = 0.90 против 0.84): камера растёт от просмотра к
  просмотру, а контур яйца во всех трёх картинках один и тот же.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="160dp"
    android:height="210dp"
    android:viewportWidth="160"
    android:viewportHeight="210">

    <!-- Скорлупа. -->
    <path
        android:pathData="M80,14 C114,14 142,48 142,90 C142,148 114,196 80,196 C46,196 18,148 18,90 C18,48 46,14 80,14 Z"
        android:fillColor="#EE6A12" />

    <!--
      Зародыш занял почти всё: ниже камеры яйцо уже не просвечивает.

      Тень — это сам контур скорлупы, залитый тёмным, а не эллипс поверх него: эллипс
      пришлось бы подгонять под кривую на глаз, и на низком конце он всё равно вылезал
      за край. Светлым остаётся только то, что закрасит камера следующим слоем.
    -->
    <path
        android:pathData="M80,14 C114,14 142,48 142,90 C142,148 114,196 80,196 C46,196 18,148 18,90 C18,48 46,14 80,14 Z"
        android:fillColor="#C74408"
        android:fillAlpha="0.8" />
    <!-- Сгусток в середине: плотнее всего яйцо там, где сам зародыш. -->
    <path
        android:pathData="M80,146 m-42,0 a42,40 0 1,0 84,0 a42,40 0 1,0 -84,0 Z"
        android:fillColor="#A8340A"
        android:fillAlpha="0.45" />

    <!-- Воздушная камера: большая, с неровным полом. -->
    <path
        android:pathData="M80,14 C110.6,14 136.3,41.5 141.2,77.7 C132,88 122,76 112,84 C102,92 92,78 80,86 C68,94 58,80 46,86 C34,92 26,84 18.8,77.7 C23.7,41.5 49.4,14 80,14 Z"
        android:fillColor="#FFE3A0" />

    <!-- Сосуды видны только у границы камеры — глубже яйцо уже не просвечивает. -->
    <group>
        <path
            android:pathData="M112,86 C116,94 120,102 122,112"
            android:strokeColor="#8E2A06"
            android:strokeAlpha="0.5"
            android:strokeWidth="1.8"
            android:strokeLineCap="round" />
        <path
            android:pathData="M80,88 C80,98 81,108 80,118"
            android:strokeColor="#8E2A06"
            android:strokeAlpha="0.5"
            android:strokeWidth="1.8"
            android:strokeLineCap="round" />
        <path
            android:pathData="M47,88 C44,96 41,104 40,114"
            android:strokeColor="#8E2A06"
            android:strokeAlpha="0.5"
            android:strokeWidth="1.8"
            android:strokeLineCap="round" />
        <path
            android:pathData="M122,112 C126,118 129,122 132,126"
            android:strokeColor="#8E2A06"
            android:strokeAlpha="0.4"
            android:strokeWidth="1.2"
            android:strokeLineCap="round" />
        <path
            android:pathData="M80,118 C74,124 70,128 64,132"
            android:strokeColor="#8E2A06"
            android:strokeAlpha="0.4"
            android:strokeWidth="1.2"
            android:strokeLineCap="round" />
        <path
