<?xml version="1.0" encoding="utf-8"?>
<!--
    Пути, которые FileProvider соглашается отдавать наружу.

    Ровно один каталог, и он в кэше: «exports» — куда «Отправить в другое приложение»
    кладёт копию базы перед тем, как передать её чужому приложению. Рабочая база в этот
    список не входит намеренно — отдавать наружу файл, в который Room прямо сейчас
    пишет, значило бы отдать его в неизвестном состоянии, без контрольной точки WAL.
-->
<paths>
    <cache-path name="exports" path="exports/" />
</paths>
